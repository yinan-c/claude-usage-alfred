#!/usr/bin/python3
"""Render the selected providers or open the active provider’s usage page."""
from __future__ import annotations

import json
import os
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import date, datetime, timedelta
from pathlib import Path
from typing import Dict, List, Optional

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

import codex
import usage

WEEKS = 13
CELL = 15
GAP = 3
GRID_W = WEEKS * CELL + (WEEKS - 1) * GAP
GRID_H = 7 * CELL + 6 * GAP
DAY_W, DAY_GAP = 26, 4  # weekday labels column, left of the grid
MONTH_H, MONTH_GAP = 13, 3  # month labels row, above the grid
HEAT_W = DAY_W + DAY_GAP + GRID_W
HEAT_H = MONTH_H + MONTH_GAP + GRID_H
WEEKDAY_LABELS = ["", "Mon", "", "Wed", "", "Fri", ""]  # rows run Sunday to Saturday
AXIS_FONT = {"size": 10}

EMPTY = {"light": "#00000014", "dark": "#ffffff17"}
FUTURE = {"light": "#00000008", "dark": "#ffffff0a"}
LEVELS = [
    {"light": "#9be9a8", "dark": "#0e4429"},
    {"light": "#40c463", "dark": "#006d32"},
    {"light": "#30a14e", "dark": "#26a641"},
    {"light": "#216e39", "dark": "#39d353"},
]
TODAY_BORDER = {"light": "#000000b0", "dark": "#ffffffd0"}
TRACK = {"light": "#0000001f", "dark": "#00000059"}


# ---------------------------------------------------------------- formatting

def money(x: float) -> str:
    if x >= 100:
        return f"${x:,.0f}"
    return f"${x:,.2f}"


def short_date(d: date) -> str:
    return f"{d:%b} {d.day}"


def duration(seconds: float) -> str:
    m = max(1, int(round(seconds / 60)))
    if m < 60:
        return f"{m}m"
    h, m = divmod(m, 60)
    if h < 24:
        return f"{h}h {m}m" if m else f"{h}h"
    d, h = divmod(h, 24)
    return f"{d}d {h}h" if h else f"{d}d"


def ago(seconds: float) -> str:
    if seconds < 90:
        return "just now"
    if seconds >= 2 * 86400:
        return f"{int(seconds // 86400)}d ago"
    return f"{duration(seconds)} ago"


def bar_colour(pct: float) -> str:
    if pct >= 90:
        return "systemRedColor"
    if pct >= 75:
        return "systemOrangeColor"
    return "systemGreenColor"


# ---------------------------------------------------------------- limits

def window_label(minutes: Optional[int]) -> str:
    if minutes == 300:
        return "5-hour session"
    if minutes == 10080:
        return "Weekly"
    if minutes and minutes % 1440 == 0:
        return f"{minutes // 1440}-day"
    if minutes:
        return f"{minutes // 60}-hour" if minutes % 60 == 0 else f"{minutes}-minute"
    return "Limit"


def limits_view(limits: Optional[dict], now: float) -> dict:
    windows = (limits or {}).get("windows") or []
    components = []
    for window in sorted(windows, key=lambda w: w.get("minutes") or 0):
        components.extend(limit_row(window, now))
    if not windows:
        components.append({"type": "label", "font": {"size": 13}, "text": "No plan limits reported"})
    return {
        "id": "planLimits", "type": "view", "layout": "inline",
        "direction": "vertical", "spacing": 8, "components": components,
    }


def limit_row(window: dict, now: float) -> List[dict]:
    label = window.get("label") or window_label(window.get("minutes"))
    pct = float(window["used_percentage"])
    resets = window.get("resets_at")
    if resets and resets <= now:
        return [{"type": "label", "font": {"size": 13},
                 "text": f"{label}: awaiting usage after reset",
                 "tooltip": f"Previous window used {pct:.0f}% and reset {ago(now - resets)}"}]
    elif resets and window.get("limited"):
        text = f"{label}: limit reached, resets in {duration(resets - now)}"
    elif resets:
        text = f"{label}: {pct:.0f}% used, resets in {duration(resets - now)}"
    else:
        text = f"{label}: {pct:.0f}% used"
    return [
        {"type": "label", "text": text, "font": {"size": 13}},
        {"type": "progress", "style": "linear", "thickness": 8, "background": TRACK,
         "progress": max(0.0, min(pct / 100.0, 1.0)), "colour": bar_colour(pct)},
    ]


# ---------------------------------------------------------------- activity

def grid_start(today: date) -> date:
    """Sunday that starts the first of the WEEKS columns (the last column is this week)."""
    this_sunday = today - timedelta(days=(today.weekday() + 1) % 7)
    return this_sunday - timedelta(weeks=WEEKS - 1)


def cost_label(cost: float, count: int, unpriced: int, compact: bool = False) -> str:
    if unpriced and unpriced == count:
        return "Unpriced"
    amount = money(cost) if compact else f"${cost:,.2f}"
    return amount + ("+" if unpriced else "")


def period_usage(days: Dict[date, usage.DailyUsage], start: date, today: date) -> dict:
    period = [value for day, value in days.items() if start <= day <= today]
    count = sum(v.count for v in period)
    unpriced = sum(v.unpriced for v in period)
    cost = cost_label(sum(v.cost for v in period), count, unpriced)
    detail = f" · {unpriced:,} requests without a model price" if unpriced else ""
    return {
        "text": f"{cost} · {count:,} req",
        "tooltip": f"{start:%Y-%m-%d} through {today:%Y-%m-%d} · estimated API cost and requests{detail}",
    }


def subscription_usage(days: Dict[date, usage.DailyUsage], today: date, provider: str) -> dict:
    prefix = "claude_" if provider == "claude" else ""
    start_text = os.environ.get(prefix + "subscription_cycle_start", "").strip()
    end_text = os.environ.get(prefix + "subscription_cycle_end", "").strip()
    settings = "Set the subscription cycle dates in Configure Workflow"
    if not start_text or not end_text:
        return {"text": "Dates needed", "tooltip": settings}
    try:
        start = date.fromisoformat(start_text)
        end = date.fromisoformat(end_text)
    except ValueError:
        return {"text": "Invalid dates", "tooltip": f"{settings} using YYYY-MM-DD"}
    if start >= end:
        return {"text": "Invalid dates", "tooltip": "The start date must be before the end date"}
    if today < start:
        return {"text": "Cycle upcoming", "tooltip": f"Starts {start:%Y-%m-%d}"}
    if today >= end:
        return {"text": "Cycle ended", "tooltip": f"Ended {end:%Y-%m-%d}. {settings} when a new cycle begins"}
    result = period_usage(days, start, today)
    result["tooltip"] += f" · cycle ends {end:%Y-%m-%d}"
    return result


def levels_for(costs: List[float]):
    """Quartile thresholds over active days, so a few huge days don't flatten the rest."""
    s = sorted(costs)
    if not s:
        return lambda c: 0
    qs = [s[min(len(s) - 1, int(len(s) * f))] for f in (0.25, 0.5, 0.75)]
    return lambda c: 1 + sum(c > q for q in qs)


def cells(days: Dict[date, usage.DailyUsage], today: date) -> List[dict]:
    start = grid_start(today)
    window = [start + timedelta(days=i) for i in range(WEEKS * 7)]
    level = levels_for([days[d].cost for d in window if d in days and d <= today])
    out = [None] * (WEEKS * 7)
    for i, d in enumerate(window):
        row, col = i % 7, i // 7
        cell: dict = {"border": {"width": 0}}
        if d > today:
            cell["background"] = FUTURE
            cell["tooltip"] = ""
        elif d in days:
            usage = days[d]
            cost, n = usage.cost, usage.count
            cell["background"] = LEVELS[level(cost) - 1]
            cell["tooltip"] = f"{d:%a}, {short_date(d)} · {cost_label(cost, n, usage.unpriced, compact=True)} · {n:,} request{'s' if n != 1 else ''}"
        else:
            cell["background"] = EMPTY
            cell["tooltip"] = f"{d:%a}, {short_date(d)} · no activity"
        if d == today:
            cell["border"] = {"width": 1, "colour": TODAY_BORDER}
            cell["tooltip"] = "Today · " + cell["tooltip"].split(" · ", 1)[1]
        out[row * WEEKS + col] = cell  # grid fills row by row: one row per weekday
    return out


def month_row(today: date) -> dict:
    """Month names along the top, each starting above the first week whose Sunday is in that month."""
    start = grid_start(today)
    starts = [c for c in range(WEEKS) if (start + timedelta(weeks=c)).day <= 7]
    if not starts or starts[0] != 0:
        starts.insert(0, 0)  # the month already under way in the first column
    comps: List[dict] = [{"type": "view", "constraints": {"size": {"width": DAY_W + DAY_GAP}}}]
    for i, col in enumerate(starts):
        end = starts[i + 1] if i + 1 < len(starts) else WEEKS
        span = end - col
        width = span * (CELL + GAP) - (GAP if end == WEEKS else 0)
        comps.append({
            "type": "label",
            "text": f"{start + timedelta(weeks=col):%b}" if span >= 2 else "",  # one column is too narrow
            "colour": "secondaryLabelColor",
            "font": AXIS_FONT,
            "linebreak": "clip",
            "constraints": {"size": {"width": width}},
        })
    return {
        "id": "monthRow",
        "type": "view",
        "layout": "inline",
        "direction": "horizontal",
        "constraints": {"region": "top", "size": {"height": MONTH_H}, "insets": {"bottom": MONTH_GAP}},
        "components": comps,
    }


def heatmap_view(cell_props: List[dict], today: date) -> dict:
    comps = []
    for i, props in enumerate(cell_props):
        comp = {"id": f"cell{i}", "type": "view", "cornerradius": 3}
        comp.update(props)
        comps.append(comp)
    weekdays = {
        "type": "view",
        "layout": "grid",
        "rows": 7,
        "cols": 1,
        "spacing": GAP,
        "constraints": {"region": "left", "size": {"width": DAY_W}, "insets": {"right": DAY_GAP}},
        "components": [
            {
                "type": "label",
                "text": text,
                "colour": "secondaryLabelColor",
                "font": AXIS_FONT,
                "textalign": "right",
                "constraints": {"position": "right"},
            }
            for text in WEEKDAY_LABELS
        ],
    }
    grid = {
        "type": "view",
        "layout": "grid",
        "rows": 7,
        "cols": WEEKS,
        "spacing": GAP,
        "constraints": {"region": "centre", "size": {"width": GRID_W, "height": GRID_H}},
        "components": comps,
    }
    return {
        "type": "view",
        "layout": "border",
        "constraints": {"size": {"width": HEAT_W, "height": HEAT_H}, "position": "centre"},
        "components": [month_row(today), weekdays, grid],
    }


# ---------------------------------------------------------------- main

NAMES = {"codex": "Codex", "claude": "Claude Code"}
URLS = {"codex": "https://chatgpt.com/codex/settings/usage", "claude": "https://claude.ai/settings/usage"}
ORDERS = {"codex": ("codex",), "claude": ("claude",), "codex_claude": ("codex", "claude"),
          "claude_codex": ("claude", "codex")}


def provider_panel(provider: str) -> dict:
    name = NAMES[provider]
    live = os.environ.get("live_limits", "").lower() in ("1", "true", "yes")
    if provider == "codex":
        requests, recorded, missing = codex.scan()
        limits = (codex.account_limits(codex.codex_home()) if live else None) or recorded
        if limits and limits.get("updated_at"):
            updated = ago(time.time() - limits["updated_at"])
            source = "Codex account" if limits.get("source") == "account" else "local session"
            footer = f"Limits from {source} · updated {updated} · cost is an API-price estimate"
        else:
            footer = "No limits recorded yet · cost is an API-price estimate"
    else:
        cfg = usage.config_dir()
        requests, rejections = usage.collect(cfg)
        limits = usage.account_limits(cfg) if live else None
        if limits and limits.get("windows"):
            footer = "Limits from Claude Code · cost is an API-price estimate"
        else:
            limits = usage.load_limits(cfg, rejections)
            updated = (limits or {}).get("updated_at")
            footer = (f"Local Claude limits · updated {ago(time.time() - updated)}" if updated
                      else "Local Claude activity") + " · cost is an API-price estimate"
        missing = False

    if missing:
        footer += " · some local logs could not be read"
    now = time.time()
    today = datetime.fromtimestamp(now).date()
    ids = {"title": {"text": name + " Usage", "tooltip": (limits or {}).get("plan") or name},
           "planLimits": limits_view(limits, now), "footer": {"text": footer}}
    days = usage.daily_totals(requests)
    start = grid_start(today)
    in_window = {d: v for d, v in days.items() if start <= d <= today}
    ids["gridUsage"] = period_usage(days, start, today)
    if days:
        ids["gridUsage"]["tooltip"] += " · All time: " + period_usage(days, min(days), today)["text"]
    ids["cycleUsage"] = subscription_usage(days, today, provider)
    ids["weekUsage"] = period_usage(days, today - timedelta(days=today.weekday()), today)
    ids["monthUsage"] = period_usage(days, today.replace(day=1), today)

    streak = usage.current_streak(days, today)
    ids["streakLabel"] = {
        "text": f"🔥 {streak}" if streak else "",
        "tooltip": f"{streak}-day streak" if streak else "",
    }
    ids["activeDays"] = {"text": str(len(in_window))}
    if in_window:
        busiest = max(in_window, key=lambda d: (in_window[d].cost, in_window[d].count, d))
        day = in_window[busiest]
        ids["busiestDay"] = {"text": f"{short_date(busiest)} · {cost_label(day.cost, day.count, day.unpriced, compact=True)}",
                             "tooltip": "Highest known estimated cost in the activity grid"}
    else:
        ids["busiestDay"] = {"text": "–"}
    t = days.get(today)
    ids["todayLabel"] = {"text": f"{cost_label(t.cost, t.count, t.unpriced, compact=True)} · {t.count:,} req" if t else "–"}

    ids["heatmap"] = heatmap_view(cells(days, today), today)

    def populate(component):
        key = component.pop("id", None)
        if key in ids:
            component.update(ids[key])
        if key:
            component["id"] = f"{provider}_{key}"
        for child in component.get("components", []):
            populate(child)

    components = json.loads(Path(__file__).with_name("provider.json").read_text())
    for component in components:
        populate(component)
    return {"type": "view", "id": provider, "layout": "inline", "direction": "vertical",
            "spacing": 8, "components": components}


def safe_panel(provider):
    try:
        return provider_panel(provider)
    except Exception as exc:
        return {"type": "label", "text": f"{NAMES[provider]} Usage · {type(exc).__name__}: {exc}"}


def select_action(provider, other, codex_selected, claude_selected):
    # Alfred captures action variables before applying the update. A rapid second
    # Tab therefore sees the selection made by the first key event.
    return {"type": "json", "variables": {
        "target": provider, "alternate": other, "choose_codex": codex_selected,
        "choose_claude": claude_selected,
    }, "src": {
        "variables": {"tool": "{var:target}", "other_provider": "{var:alternate}",
                      "codex_selected": "{var:choose_codex}", "claude_selected": "{var:choose_claude}"},
        "update": {"ids": {
            "page_codex": {"hidden": "{var:choose_claude}"},
            "page_claude": {"hidden": "{var:choose_codex}"},
            "tab_codex": {"bordered": "{var:choose_codex}"},
            "tab_claude": {"bordered": "{var:choose_claude}"},
        }},
    }}


def tab_strip(order, active):
    tabs = []
    for index, provider in enumerate(order):
        action = select_action(provider, order[1 - index],
                               int(provider == "codex"), int(provider == "claude"))
        tabs.append({
            "type": "button", "text": NAMES[provider], "id": f"tab_{provider}",
            "bordered": provider == active, "bordershape": "capsule", "font": {"size": 14},
            "constraints": {"size": {"width": 108 if provider == "claude" else 74}},
            "shortcut": f"⌘{index + 1}", "tooltip": f"{NAMES[provider]} (⌘{index + 1}) · Tab to switch",
            "events": [{"triggers": "actioned", "action": action}],
        })
    return {"type": "view", "layout": "inline", "direction": "horizontal", "spacing": 4,
            "components": tabs}


def initial_view(order, active):
    pages = []
    for provider in order:
        # Refresh replaces only the inner content. Its response can never unhide
        # a page or change the currently selected provider.
        loading = {"type": "label", "id": provider, "text": f"Loading {NAMES[provider]} usage…"}
        pages.append({"type": "view", "layout": "stack", "id": f"page_{provider}",
                      "hidden": provider != active, "components": [loading]})
    shortcuts = [
        {"shortcut": "⌘R", "action": {"type": "script", "src": "render",
                                     "args": ["refresh", "{var:tool}"], "async": True}},
        {"shortcut": "↩", "action": {"type": "script", "src": "render",
                                    "args": ["open", "{var:tool}"]}},
    ]
    view = {"type": "view", "id": "providers", "layout": "inline", "direction": "vertical",
            "focus": True, "focusable": True, "shortcuts": shortcuts,
            "spacing": 10, "components": [{"type": "view", "layout": "stack", "components": pages}]}
    variables = {"tool": active}
    if len(order) == 2:
        view["components"].insert(0, tab_strip(order, active))
        variables.update(other_provider=next(p for p in order if p != active), codex_selected=int(active == "codex"),
                         claude_selected=int(active == "claude"))
        shortcuts.append({
            "shortcut": "⇥", "action": select_action("{var:other_provider}", "{var:tool}",
                                                     "{var:claude_selected}", "{var:codex_selected}")})
    return {"variables": variables, "replace": {"ids": {"providers": view}}}


def panel_content(provider, show_title):
    panel = safe_panel(provider)
    panel["id"] = provider
    if not show_title and panel.get("components"):
        panel["components"] = [c for c in panel["components"] if c.get("id") != f"{provider}_title"]
    return panel


def replace_panels(panels):
    # Embedded Alfred windows keep their initial height after replacing content.
    # Refit after the new panels are installed, keeping the user's theme width.
    return {"replace": {"ids": panels}, "window": {"resize": {"height": "auto"}}}


def build(mode: str, requested: str = "") -> dict:
    setting = os.environ.get("usage_providers") or "remember"
    order = ORDERS.get(setting, ORDERS["claude_codex"])
    if mode == "preload":
        preferred = os.environ.get("tool") if setting == "remember" else order[0]
        launch = os.environ.get("launch_tool", "").strip().lower()
        active = launch if launch in order else preferred
        return initial_view(order, active if active in order else order[0])
    if mode == "pulse" and len(order) == 2:
        # Both resident pages stay current even when one is hidden.
        with ThreadPoolExecutor(max_workers=2) as pool:
            panels = pool.map(panel_content, order, (False, False))
            return replace_panels(dict(zip(order, panels)))
    active = requested or order[0]
    if active not in order:
        return {}
    if mode == "open":
        return {"open": {"type": "url", "src": URLS[active]}, "finish": {}}
    if mode not in ("load", "pulse", "refresh"):
        return {}
    return replace_panels({active: panel_content(active, len(order) == 1)})


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else "preload"
    requested = sys.argv[2] if len(sys.argv) > 2 else ""
    out = build(mode, requested)
    print(json.dumps(out, ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    main()
