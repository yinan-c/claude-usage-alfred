{
  "bundleid": "local.claude-code.usage.ui",
  "log": { "level": "warning", "internal": true },
  "iconpath": "../icon.png",
  "variablesconfig": {
    "tool": { "default": "claude", "persist": true, "scriptenv": true },
    "launch_tool": { "src": "args[0]", "scriptenv": true },
    "claude_config_dir": { "src": "variable", "scriptenv": true },
    "live_limits": { "src": "variable", "scriptenv": true },
    "usage_providers": { "src": "variable", "scriptenv": true },
    "claude_subscription_cycle_start": { "src": "variable", "scriptenv": true },
    "claude_subscription_cycle_end": { "src": "variable", "scriptenv": true },
    "codex_home": { "src": "variable", "scriptenv": true },
    "subscription_cycle_start": { "src": "variable", "scriptenv": true },
    "subscription_cycle_end": { "src": "variable", "scriptenv": true }
  },
  "pulse": {
    "src": "render",
    "args": ["pulse"],
    "interval": 30,
    "intervalmode": "delay"
  },
  "window": {
    "title": "Codex & Claude Code Usage",
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "padding": 16,
      "spacing": 8,
      "events": [
        { "triggers": "preload", "action": { "type": "script", "src": "render", "args": "preload" } },
        { "triggers": "launched", "action": [
          { "type": "script", "src": "render", "args": ["load", "codex"], "async": true },
          { "type": "script", "src": "render", "args": ["load", "claude"], "async": true }
        ] }
      ],
      "components": [
        { "id": "providers", "type": "view", "layout": "inline", "direction": "vertical", "spacing": 16, "components": [] }
      ]
    }
  }
}
